# Production defaults. On Vercel the site address comes from
# VERCEL_PROJECT_PRODUCTION_URL; set SITE_URL to override it.
NEXT_PUBLIC_ROUTING=path

# With your own domain and wildcard DNS, serve collections on subdomains:
# SITE_URL=https://example.com
# NEXT_PUBLIC_ROUTING=subdomain
# COLLECTION_ORIGIN=https://{id}.example.com
